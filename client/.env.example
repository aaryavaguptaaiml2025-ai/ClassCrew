# ======================================================
# CLASSCREW CLIENT ENVIRONMENT CONFIGURATION
# ======================================================
# Copy this file to client/.env and fill in your Firebase Web SDK credentials.
# Get these from: Firebase Console > Project Settings > General > Your Apps > Web App

# ---------- Firebase Web SDK (Required) ----------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ---------- Backend API ----------
# URL of the ClassCrew backend API
# In development: http://localhost:5000/api
# In production: https://classcrew-backend.onrender.com/api (or your Render URL)
VITE_API_URL=http://localhost:5000/api
