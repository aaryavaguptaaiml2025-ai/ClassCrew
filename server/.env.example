# ======================================================
# CLASSCREW SERVER ENVIRONMENT CONFIGURATION
# ======================================================
# Copy this file to server/.env and fill in your credentials.

# ---------- Server ----------
# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Environment: "development" or "production"
NODE_ENV=development

# Frontend URL for CORS allowlist
# In production, set this to your Vercel deployment URL (e.g., https://classcrew.vercel.app)
CLIENT_URL=http://localhost:5173

# ---------- Supabase (Required) ----------
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL direct connection string (used only by migrations)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---------- Firebase Admin SDK (Required) ----------
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------- Application ----------
# Access code required for teacher registration
TEACHER_ACCESS_CODE=A3T26X100
