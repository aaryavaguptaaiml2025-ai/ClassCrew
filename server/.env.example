# ClassCrew Server Environment Variables

# Node Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Teacher Registration Access Code (Required for Teacher Signups)
TEACHER_ACCESS_CODE=A3T26X100

# Firebase Service Account Credentials (JSON string or file path)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your_private_key...\n-----END PRIVATE KEY-----\n"
